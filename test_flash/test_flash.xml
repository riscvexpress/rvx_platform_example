<?xml version="1.0" ?>
<rvx>
  <platform>
    <name>test_flash</name>
    <status>described</status>
    <spec>
      <define>
        <name>sram_size</name>
        <value>128kB</value>
      </define>
      <define>
        <name>include_spi_flash</name>
        <value type="bool">True</value>
      </define>
    </spec>

    <ip_instance>
      <name>i_main_core</name>
      <library_name>rvc_orca</library_name>
    </ip_instance>

    <clock_info>
      <define>
        <name>clk_system</name>
        <value type="dec">100000000</value>
      </define>
    </clock_info>

    <sim_define>
      <simulate_spi_flash type='bool'>True</simulate_spi_flash>
    </sim_define>

  </platform>
</rvx>
