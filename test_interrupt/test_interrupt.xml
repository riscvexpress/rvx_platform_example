<?xml version="1.0" ?>
<rvx>
	<platform>
		<name>test_interrupt</name>
		<status>described</status>
		<spec>
			<define>
				<name>sram_size</name>
				<value>64kB</value>
			</define>
			<define>
				<name>include_timer</name>
				<value type="bool">True</value>
			</define>
			<define>
				<name>num_led_checker</name>
				<value>1</value>
			</define>
			<define>
				<name>num_switch_slide_readymade</name>
				<value>1</value>
			</define>
			<define>
				<name>include_plic</name>
				<value type="bool">True</value>
      </define>
      <define>
				<name>include_gpio_pinmux</name>
				<value type="bool">False</value>
			</define>
			<define>
				<name>num_core_user</name>
				<value>2</value>
			</define>
			<define>
				<name>include_slow_dram</name>
				<value type="bool">True</value>
			</define>
			<define>
				<name>include_user_interrupts</name>
				<value type="bool">True</value>
			</define>
		</spec>

		<ip_instance>
			<name>i_main_core</name>
			<library_name>rvc_orca_plus</library_name>
		</ip_instance>

		<ip_instance>
			<name>i_itr_gen</name>
			<library_name>user_slaveif_apb_clkin</library_name>
			<parameter>
				<id>SIZE_OF_MEMORYMAP</id>
				<value>0x1000</value>
			</parameter>
			<parameter>
				<id>BW_ADDR</id>
				<value>32</value>
			</parameter>
			<parameter>
				<id>BW_DATA</id>
				<value>32</value>
			</parameter>
		</ip_instance>

		<gpio>
			<name>switch_slide1</name>
			<width>2</width>
		</gpio>
	</platform>
</rvx>
